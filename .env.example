# .env.example — placeholder keys only (ImplementationPlan § Day 0).
# Copy to .env and fill in real values. .env is git-ignored (DOC-010 §
# Security: secrets are never committed to version control).
#
# NOTE: The provider API keys below are TEST keys provided for development
# verification. Treat them as non-production. Rotate any key that is exposed.

# RPC endpoint for the Base collector. Any JSON-RPC endpoint works — the
# BlockchainProvider interface (ADR-006 § Provider Abstraction) is what makes
# this choice cost nothing to change later. The public Base endpoint is the
# zero-key default; point this at an Alchemy/QuickNode URL when a key exists.
RPC_URL=https://mainnet.base.org

# Alchemy (primary) — test key.
ALCHEMY_BASE_API_KEY=alch_wa08Yv63A7jLWeOubDgrY

# QuickNode (secondary) — test key.
QUICKNODE_BASE_API_KEY=7864ff0d4874cfe20ecd5655336e9d9275ce813e
QUICKNODE_BASE_SUBDOMAIN=dimensional-radial-card

# RockX / W3Node (tertiary) — test key.
ROCKX_BASE_API_KEY=c10a26e552040a4722a32839174c85b6fb1d2f13fbe58809b1d057ebdc8fccbc

# PostgreSQL (TimescaleDB) DSN — must match docker-compose.yml.
# Local dev container uses trust auth on localhost:5433.
POSTGRES_DSN=postgresql+asyncpg://onchain@localhost:5433/onchain_platform

# Redis (event transport / state cache).
REDIS_URL=redis://localhost:6379/0