# .env.example — placeholder values only (ImplementationPlan § Day 0).
# Copy to .env and fill in real values. .env is git-ignored (DOC-010 §
# Security: secrets are never committed to version control).
#
# NEVER put a real key in this file — it is tracked and public. A pre-commit
# gitleaks scan (S0-1) rejects any commit that reintroduces one.

# RPC endpoint for the Base collector. Any JSON-RPC endpoint works — the
# BlockchainProvider interface (ADR-006 § Provider Abstraction) is what makes
# this choice cost nothing to change later. The public Base endpoint is the
# zero-key default; point this at an Alchemy/QuickNode URL when a key exists.
RPC_URL=https://mainnet.base.org

# Alchemy (primary).
ALCHEMY_BASE_API_KEY=__REPLACE_ME__

# QuickNode (secondary).
QUICKNODE_BASE_API_KEY=__REPLACE_ME__
QUICKNODE_BASE_SUBDOMAIN=__REPLACE_ME__

# RockX / W3Node (tertiary).
ROCKX_BASE_API_KEY=__REPLACE_ME__

# PostgreSQL (TimescaleDB) — must match docker-compose.yml.
# The dev container requires a scram-sha-256 password (S0-3); set it here and
# embed the same value in POSTGRES_DSN below. Host port is 5433 → container 5432.
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_DSN=postgresql+asyncpg://onchain:__REPLACE_ME__@localhost:5433/onchain_platform

# Redis (event transport / state cache). The dev container requires a password
# (S0-3); set it here and embed the same value in REDIS_URL below.
REDIS_PASSWORD=__REPLACE_ME__
REDIS_URL=redis://:__REPLACE_ME__@localhost:6379/0
